pipeline {
    agent any

    environment {
        MLFLOW_TRACKING_URI = "http://mlflow:5000"
        MLFLOW_S3_ENDPOINT_URL = "http://minio:9000"
        AWS_ACCESS_KEY_ID = "minioadmin"
        AWS_SECRET_ACCESS_KEY = "minioadmin"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'development',
                    url: 'https://github.com/arunprem/mechinelearning-project.git'
            }
        }

        stage('Compare New Model w/ Production') {
            steps {
                sh '''
                    echo "=== 🧪 Running MLflow Model Comparison ==="
                    echo "Workspace: ${WORKSPACE}"
                    echo "Running: python3 ${WORKSPACE}/mlflow_ci/compare.py"

                    python3 "${WORKSPACE}/mlflow_ci/compare.py"

                    echo "=== Comparison Finished ==="
                    echo "Result file content:"
                    cat compare_result.txt
                '''
            }
        }

        stage('Promote If Better') {
            steps {
                script {
                    def decision = readFile('compare_result.txt').trim()
                    echo "COMPARE_RESULT: ${decision}"

                    if (decision == "PROMOTE") {
                        echo "🚀 PROMOTING MODEL..."
                        sh "python3 \"${WORKSPACE}/mlflow_ci/promote.py\""
                    } else {
                        echo "⚠️ Keeping old model — new model is not better."
                    }
                }
            }
        }
    }

    post {
        success { echo "🎉 MLflow CI/CD Pipeline SUCCESS" }
        failure { echo "❌ MLflow CI/CD Pipeline FAILED" }
    }
}
